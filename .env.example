# MySQL development database (use a separate database for automated tests)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/yoranzify_dev"
TEST_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/yoranzify_test"
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/yoranzify_shadow"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"
LOG_LEVEL="info"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="8388608"

# Added in later modules
SESSION_SECRET="replace-with-at-least-32-random-characters"
INITIAL_ADMIN_NAME="Store Admin"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_MOBILE=""
INITIAL_ADMIN_PASSWORD=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Local/E2E only. Never enable this in production.
RAZORPAY_MOCK="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Yoranzify <no-reply@yoranzify.com>"
# Address that receives operational notifications such as new orders.
ADMIN_NOTIFICATION_EMAIL=""
OPS_JOB_SECRET="replace-with-at-least-32-random-characters"
