generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// A minimal foundation record used to verify database connectivity in Module 0.
// Business domain models are introduced with their owning modules.
model SystemRecord {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(100)
  email              String               @unique @db.VarChar(191)
  mobile             String               @unique @db.VarChar(20)
  passwordHash       String               @db.VarChar(255)
  role               UserRole             @default(CUSTOMER)
  isActive           Boolean              @default(true)
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  inventoryMovements InventoryMovement[]
  cart               Cart?
  wishlist           Wishlist?
  addresses          Address[]
  couponUsages       CouponUsage[]
  couponAccess       CouponCustomer[]
  orders             Order[]
  adminAudits        AdminAudit[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([role, isActive])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String      @db.VarChar(100)
  mobile            String      @db.VarChar(20)
  line1             String      @db.VarChar(180)
  line2             String?     @db.VarChar(180)
  landmark          String?     @db.VarChar(120)
  city              String      @db.VarChar(100)
  state             String      @db.VarChar(100)
  postalCode        String      @db.VarChar(12)
  country           String      @default("India") @db.VarChar(80)
  type              AddressType @default(HOME)
  isDefaultShipping Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, isDefaultShipping])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.Char(64)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.Char(64)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id @db.VarChar(191)
  attempts  Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

enum MediaKind {
  LOGO
  FAVICON
  PRODUCT
  CATEGORY
  BANNER
  REVIEW
}

model MediaAsset {
  id              Int            @id @default(autoincrement())
  kind            MediaKind
  originalName    String         @db.VarChar(255)
  storageKey      String         @unique @db.VarChar(255)
  mimeType        String         @db.VarChar(100)
  byteSize        Int
  width           Int
  height          Int
  checksum        String         @db.Char(64)
  logoForSettings SiteSetting[]  @relation("SettingsLogo")
  iconForSettings SiteSetting[]  @relation("SettingsFavicon")
  categoryImages  Category[]
  productImages   ProductImage[]
  desktopBanners  Banner[]       @relation("BannerDesktop")
  mobileBanners   Banner[]       @relation("BannerMobile")
  createdAt       DateTime       @default(now())

  @@index([kind, createdAt])
}

enum HomepageSectionType {
  HERO
  CATEGORIES
  NEW_ARRIVALS
  TRENDING
  BEST_SELLERS
  OFFERS
  FEATURED_COLLECTION
  GALLERY
  TESTIMONIALS
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model EmailOutbox {
  id            Int         @id @default(autoincrement())
  dedupeKey     String      @unique @db.VarChar(191)
  recipient     String      @db.VarChar(191)
  template      String      @db.VarChar(60)
  subject       String      @db.VarChar(180)
  html          String      @db.LongText
  text          String      @db.Text
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?     @db.VarChar(500)
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, nextAttemptAt])
}

model Banner {
  id             Int         @id @default(autoincrement())
  desktopMediaId Int
  desktopMedia   MediaAsset  @relation("BannerDesktop", fields: [desktopMediaId], references: [id], onDelete: Restrict)
  mobileMediaId  Int?
  mobileMedia    MediaAsset? @relation("BannerMobile", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  altText        String      @db.VarChar(180)
  title          String      @db.VarChar(160)
  subtitle       String?     @db.VarChar(300)
  buttonText     String?     @db.VarChar(60)
  buttonUrl      String?     @db.VarChar(500)
  position       Int         @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([enabled, startsAt, endsAt, position])
}

model HomepageSection {
  id        Int                 @id @default(autoincrement())
  type      HomepageSectionType @unique
  title     String?             @db.VarChar(160)
  subtitle  String?             @db.VarChar(300)
  linkUrl   String?             @db.VarChar(500)
  enabled   Boolean             @default(true)
  position  Int                 @default(0)
  updatedAt DateTime            @updatedAt

  @@index([enabled, position])
}

model Category {
  id               Int                 @id @default(autoincrement())
  name             String              @db.VarChar(100)
  slug             String              @unique @db.VarChar(120)
  description      String?             @db.Text
  parentId         Int?
  parent           Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]          @relation("CategoryTree")
  imageMediaId     Int?
  image            MediaAsset?         @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products         Product[]
  promotionTargets PromotionCategory[]
  displayOrder     Int                 @default(0)
  shippingChargePaise Int?
  freeShippingAbovePaise Int?
  isVisible        Boolean             @default(true)
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([parentId, displayOrder])
  @@index([isVisible, archivedAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProductGender {
  WOMEN
  MEN
  UNISEX
  KIDS
}

enum InventoryReason {
  INITIAL
  RESTOCK
  CORRECTION
  SALE
  CANCELLATION
  RETURN
}

model Product {
  id                  Int                @id @default(autoincrement())
  name                String             @db.VarChar(180)
  slug                String             @unique @db.VarChar(200)
  skuReference        String             @unique @db.VarChar(80)
  shortDescription    String?            @db.VarChar(500)
  description         String?            @db.Text
  categoryId          Int
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand               String?            @db.VarChar(100)
  gender              ProductGender
  regularPricePaise   Int
  salePricePaise      Int?
  gstPercent          Decimal            @default(0) @db.Decimal(5, 2)
  hsnCode             String?            @db.VarChar(20)
  status              ProductStatus      @default(DRAFT)
  isFeatured          Boolean            @default(false)
  isBestSeller        Boolean            @default(false)
  isNewArrival        Boolean            @default(false)
  deliveredSalesCount Int                @default(0)
  seoTitle            String?            @db.VarChar(180)
  seoDescription      String?            @db.VarChar(320)
  images              ProductImage[]
  variants            ProductVariant[]
  wishlistItems       WishlistItem[]
  promotionTargets    PromotionProduct[]
  orderItems          OrderItem[]
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([categoryId, status, archivedAt])
  @@index([gender, status])
  @@index([isFeatured, isBestSeller, isNewArrival])
  @@index([status, deliveredSalesCount, createdAt])
}

model ProductImage {
  id        Int        @id @default(autoincrement())
  productId Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  altText   String     @db.VarChar(255)
  position  Int        @default(0)

  @@unique([productId, mediaId])
  @@unique([productId, position])
}

model Color {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(60)
  hex      String           @db.Char(7)
  variants ProductVariant[]
}

model Size {
  id           Int              @id @default(autoincrement())
  name         String           @unique @db.VarChar(30)
  displayOrder Int              @default(0)
  variants     ProductVariant[]
}

model ProductVariant {
  id                 Int                    @id @default(autoincrement())
  productId          Int
  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId            Int
  color              Color                  @relation(fields: [colorId], references: [id], onDelete: Restrict)
  sizeId             Int
  size               Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  sku                String                 @unique @db.VarChar(100)
  priceOverridePaise Int?
  stockQuantity      Int                    @default(0)
  lowStockThreshold  Int?
  weightGrams        Int?
  isActive           Boolean                @default(true)
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  reservations       InventoryReservation[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([productId, colorId, sizeId])
  @@index([productId, isActive])
  @@index([stockQuantity])
}

model Cart {
  id             Int        @id @default(autoincrement())
  userId         Int?       @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?    @unique @db.Char(64)
  couponId       Int?
  coupon         Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          CartItem[]
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([expiresAt])
}

model CartItem {
  id                     Int            @id @default(autoincrement())
  cartId                 Int
  cart                   Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId              Int
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity               Int
  lastSeenUnitPricePaise Int
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         Int             @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  Int?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model InventoryMovement {
  id        Int             @id @default(autoincrement())
  variantId Int
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta     Int
  balance   Int
  reason    InventoryReason
  note      String?         @db.VarChar(500)
  actorId   Int?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([actorId])
}

model SiteSetting {
  id                     Int         @id @default(1)
  storeName              String      @default("Yoranzify") @db.VarChar(100)
  contactNumber          String?     @db.VarChar(20)
  whatsappNumber         String?     @db.VarChar(20)
  contactEmail           String?     @db.VarChar(191)
  address                String?     @db.Text
  instagramUrl           String?     @db.VarChar(500)
  facebookUrl            String?     @db.VarChar(500)
  gstNumber              String?     @db.VarChar(20)
  currency               String      @default("INR") @db.Char(3)
  shippingChargePaise    Int         @default(9900)
  freeShippingAbovePaise Int         @default(199900)
  platformFeePaise       Int         @default(0)
  lowStockThreshold      Int         @default(5)
  codEnabled             Boolean     @default(true)
  maintenanceMode        Boolean     @default(false)
  logoMediaId            Int?
  faviconMediaId         Int?
  logo                   MediaAsset? @relation("SettingsLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  favicon                MediaAsset? @relation("SettingsFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum CouponUsageStatus {
  RESERVED
  REDEEMED
  RELEASED
}

model Coupon {
  id                   Int              @id @default(autoincrement())
  code                 String           @unique @db.VarChar(40)
  description          String?          @db.VarChar(255)
  discountType         DiscountType
  discountValue        Int
  minimumSpendPaise    Int              @default(0)
  maximumDiscountPaise Int?
  firstOrderOnly       Boolean          @default(false)
  usageLimit           Int?
  perUserLimit         Int?
  enabled              Boolean          @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  carts                Cart[]
  usages               CouponUsage[]
  customers            CouponCustomer[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([enabled, startsAt, endsAt])
}

model CouponCustomer {
  couponId Int
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
  @@index([userId])
}

model CouponUsage {
  id        Int               @id @default(autoincrement())
  couponId  Int
  coupon    Coupon            @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId    Int
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    CouponUsageStatus @default(RESERVED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  orderId   Int?              @unique
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, status])
  @@index([couponId, userId, status])
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReservationStatus {
  CONSUMED
  RELEASED
}

enum FulfillmentMethod {
  THIRD_PARTY
  SELF_DELIVERY
}

model Order {
  id                       Int                    @id @default(autoincrement())
  orderNumber              String                 @unique @db.VarChar(32)
  idempotencyKey           String                 @unique @db.VarChar(64)
  userId                   Int
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                   OrderStatus            @default(PLACED)
  paymentMethod            PaymentMethod
  paymentStatus            PaymentStatus          @default(PENDING)
  addressFullName          String                 @db.VarChar(100)
  addressMobile            String                 @db.VarChar(20)
  addressLine1             String                 @db.VarChar(180)
  addressLine2             String?                @db.VarChar(180)
  addressLandmark          String?                @db.VarChar(120)
  addressCity              String                 @db.VarChar(100)
  addressState             String                 @db.VarChar(100)
  addressPostalCode        String                 @db.VarChar(12)
  addressCountry           String                 @db.VarChar(80)
  merchandiseSubtotalPaise Int
  automaticDiscountPaise   Int                    @default(0)
  couponCode               String?                @db.VarChar(40)
  couponDiscountPaise      Int                    @default(0)
  shippingPaise            Int                    @default(0)
  platformFeePaise         Int                    @default(0)
  taxPaise                 Int                    @default(0)
  totalPaise               Int
  courierName              String?                @db.VarChar(100)
  trackingNumber           String?                @db.VarChar(120)
  trackingUrl              String?                @db.VarChar(500)
  fulfillmentMethod        FulfillmentMethod      @default(THIRD_PARTY)
  internalNotes            String?                @db.Text
  shippedAt                DateTime?
  deliveredAt              DateTime?
  items                    OrderItem[]
  history                  OrderStatusHistory[]
  reservations             InventoryReservation[]
  couponUsage              CouponUsage?
  payments                 Payment[]
  cancelledAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdminAudit {
  id         Int      @id @default(autoincrement())
  actorId    Int
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(100)
  summary    String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

enum PaymentRecordStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  EXPIRED
  REFUNDED
}

model Payment {
  id                 Int                 @id @default(autoincrement())
  orderId            Int
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  gatewayOrderId     String              @unique @db.VarChar(80)
  gatewayPaymentId   String?             @unique @db.VarChar(80)
  status             PaymentRecordStatus @default(INITIATED)
  amountPaise        Int
  currency           String              @default("INR") @db.Char(3)
  failureCode        String?             @db.VarChar(100)
  failureDescription String?             @db.VarChar(500)
  expiresAt          DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
}

model WebhookEvent {
  id             Int       @id @default(autoincrement())
  gatewayEventId String    @unique @db.VarChar(100)
  eventType      String    @db.VarChar(100)
  payloadHash    String    @db.Char(64)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([eventType, createdAt])
}

model OrderItem {
  id                     Int            @id @default(autoincrement())
  orderId                Int
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId              Int
  product                Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId              Int
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName            String         @db.VarChar(180)
  productSlug            String         @db.VarChar(200)
  sku                    String         @db.VarChar(100)
  colorName              String         @db.VarChar(60)
  sizeName               String         @db.VarChar(30)
  quantity               Int
  unitPricePaise         Int
  automaticDiscountPaise Int            @default(0)
  couponDiscountPaise    Int            @default(0)
  taxPaise               Int            @default(0)
  lineTotalPaise         Int

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?     @db.VarChar(255)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model InventoryReservation {
  id         Int               @id @default(autoincrement())
  orderId    Int
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId  Int
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  status     ReservationStatus @default(CONSUMED)
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  @@unique([orderId, variantId])
  @@index([variantId, status])
}

model Promotion {
  id                   Int                 @id @default(autoincrement())
  name                 String              @db.VarChar(120)
  description          String?             @db.VarChar(255)
  discountType         DiscountType
  discountValue        Int
  maximumDiscountPaise Int?
  enabled              Boolean             @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  products             PromotionProduct[]
  categories           PromotionCategory[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([enabled, startsAt, endsAt])
}

model PromotionProduct {
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}
